generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  platform_admin
  admin
  assistant
}

enum CampaignStatus {
  draft
  scheduled
  sending
  done
  cancelled
}

enum MessageCategory {
  marketing
  utility
}

enum TemplateStatus {
  draft
  pending
  approved
  rejected
  paused
}

enum TemplateHeaderType {
  none
  text
  image
}

enum OptInState {
  awaiting_consent
  awaiting_name
  confirmed
  opted_out
}

enum ConsentEventType {
  granted
  revoked
}

model Company {
  id             String   @id @default(uuid())
  name           String
  whatsappNumber String   @unique
  birdChannelId  String?
  supportPhone   String?
  active         Boolean  @default(true)
  credits        Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  users         User[]
  contacts      Contact[]
  campaigns     Campaign[]
  creditLogs    CreditLog[]
  optInSessions OptInSession[]
  consentEvents ConsentEvent[]
  uploads       Upload[]
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      Role
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])

  loginOtpCode         String?
  loginOtpExpires      DateTime?
  twoFactorSecret      String?
  passwordResetToken   String?   @unique
  passwordResetExpires DateTime?

  impersonationLogs ImpersonationLog[]
  templatesApproved Template[]
}

model Contact {
  id            String   @id @default(uuid())
  phone         String
  name          String?
  consentAt     DateTime
  consentIp     String?
  consentSource String?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  messagesSent  CampaignMessage[]
  consentEvents ConsentEvent[]

  @@unique([companyId, phone])
}

// Estado da conversa de double opt-in por WhatsApp (uma por empresa + telefone).
model OptInSession {
  id            String     @id @default(uuid())
  phone         String
  channelId     String?
  state         OptInState @default(awaiting_consent)
  profileName   String?
  chosenName    String?
  lastPromptAt  DateTime?
  // Último aviso "fora do escopo" / convite a inscrever-se (throttle anti-spam).
  lastNudgeAt   DateTime?
  lastInboundId String?
  // Prova do "SIM" de consentimento (antes de escolher o nome).
  consentText      String?
  consentInboundId String?
  consentAt        DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, phone])
}

// Registo append-only de consentimento / revogação (prova RGPD/LGPD).
model ConsentEvent {
  id                String           @id @default(uuid())
  phone             String
  name              String?
  type              ConsentEventType
  channel           String           @default("whatsapp")
  promptText        String?
  promptVersion     String?
  replyText         String?
  inboundMessageId  String?
  providerTimestamp DateTime?
  rawPayload        Json?
  createdAt         DateTime         @default(now())

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id])
}

model Template {
  id       String          @id @default(uuid())
  name     String
  category MessageCategory
  language String          @default("pt_BR") // locale Bird (ex.: pt_BR)
  channel  String          @default("whatsapp")

  // Ligação ao template já criado/aprovado no Bird Studio (colado à mão pelo admin).
  birdProjectId String?
  birdVersionId String?
  birdWabaId    String?

  // O tipo de cabeçalho é definido pelo admin; quando é 'image', a imagem em si
  // é carregada pelo cliente na campanha (ligada a uma variável), nunca aqui.
  headerType TemplateHeaderType @default(none)
  headerText String?
  bodyText   String
  footerText     String?
  buttons        Json? // [{ type: 'url' | 'quick_reply', text, url? }]
  variables      String[]

  status          TemplateStatus @default(draft)
  rejectionReason String?
  approvedAt      DateTime?
  approvedById    String?
  approvedBy      User?          @relation(fields: [approvedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campaigns Campaign[]
}

model Campaign {
  id             String         @id @default(uuid())
  name           String
  status         CampaignStatus @default(draft)
  scheduledAt    DateTime?
  sentAt         DateTime?
  totalSent      Int            @default(0)
  totalFailed    Int            @default(0)
  creditsCost    Int            @default(0)
  filters        Json?
  variableValues Json?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  templateId String
  template   Template @relation(fields: [templateId], references: [id])

  messages CampaignMessage[]
}

model CampaignMessage {
  id            String    @id @default(uuid())
  birdMessageId String?
  // pending | sent | delivered | read | failed
  status        String    @default("pending")
  sentAt        DateTime?
  deliveredAt   DateTime?
  readAt        DateTime?
  failedAt      DateTime?
  failReason    String?
  updatedAt     DateTime  @updatedAt

  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id])

  contactId String
  contact   Contact @relation(fields: [contactId], references: [id])
}

model CreditLog {
  id           String   @id @default(uuid())
  amount       Int
  description  String
  balanceAfter Int
  createdAt    DateTime @default(now())

  companyId String
  company   Company @relation(fields: [companyId], references: [id])
}

model ImpersonationLog {
  id              String    @id @default(uuid())
  targetCompanyId String
  startedAt       DateTime  @default(now())
  endedAt         DateTime?

  adminId String
  admin   User   @relation(fields: [adminId], references: [id])
}

// Ficheiro (imagem/PDF) carregado para o Cloudflare R2.
// companyId nulo = asset da plataforma (upload do platform_admin para um template).
model Upload {
  id        String   @id @default(uuid())
  companyId String?
  filename  String // nome original do ficheiro
  key       String // chave completa no R2
  url       String // R2_PUBLIC_URL + "/" + key
  mimeType  String // image/png | image/jpeg | application/pdf
  size      Int // bytes
  createdAt DateTime @default(now())

  company Company? @relation(fields: [companyId], references: [id])
}
