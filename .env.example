DATABASE_URL=postgresql://user:password@localhost:5432/projeto_verde
# Gerar com: openssl rand -base64 48  (mínimo 32 caracteres em produção)
JWT_SECRET=
PORT=3001
FRONTEND_URL=http://localhost:3000

# Seed do primeiro platform_admin (npm run db:seed). Sem defaults: ambas obrigatórias,
# password com 12+ caracteres. Não deixar aqui em produção.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Cloudflare R2 (uploads de imagem/PDF para templates e campanhas)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=projeto-verde
R2_PUBLIC_URL=https://storage.passaros.online

# Bird.com
BIRD_API_KEY=
BIRD_WORKSPACE_ID=
BIRD_API_BASE=https://api.bird.com
# Autenticação do webhook /api/webhooks/bird — em produção UM dos dois é obrigatório:
# 1) Signing secret da subscrição no Bird (formato whsec_...). Valida a assinatura
#    HMAC dos headers webhook-id / webhook-timestamp / webhook-signature.
BIRD_WEBHOOK_SIGNING_SECRET=
# 2) Segredo partilhado (16+ caracteres) enviado no header x-webhook-secret ou no
#    próprio URL da subscrição: https://<api>/api/webhooks/bird?secret=<valor>
BIRD_WEBHOOK_SECRET=
# Versão do texto de consentimento (guardada em cada ConsentEvent para prova RGPD/LGPD).
CONSENT_PROMPT_VERSION=2026-09-v1
# Palavras (separadas por vírgula) que arrancam / confirmam o opt-in e o opt-out.
OPTIN_KEYWORDS=sim,quero,aceito,yes,start,novidades
OPTOUT_KEYWORDS=sair,parar,stop,cancelar,unsubscribe
# Template do Bird para o aviso "fora do escopo" (botão "Conversar" -> wa.me/<numero_whatsapp>).
BIRD_OUT_OF_SCOPE_TEMPLATE_PROJECT_ID=63e6e41e-f0ff-4fa8-94ff-d45a500ee3be
BIRD_OUT_OF_SCOPE_TEMPLATE_VERSION=2e7168d2-a565-4662-a1be-1d7fc8504f81
BIRD_OUT_OF_SCOPE_TEMPLATE_LOCALE=pt_BR

# Cloudflare Turnstile (verificação anti-bot em login/forgot-password/reset-password)
# Site Key/Secret Key em https://dash.cloudflare.com -> Turnstile
TURNSTILE_SECRET_KEY=

# Resend (emails de recuperação de senha)
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@passaros.online
PASSWORD_RESET_TOKEN_EXPIRY_MIN=30
LOGIN_OTP_EXPIRY_MIN=10
